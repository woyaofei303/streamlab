{
  "name": "streamlab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:deploy": "python3 -m unittest discover -s tests -p test_deploy.py",
    "test:e2e": "playwright test",
    "prepare": "husky",
    "media:generate": "node scripts/generate-media.mjs",
    "media:up": "docker compose -f media/compose.yml up -d",
    "media:down": "docker compose -f media/compose.yml down",
    "media:check": "node scripts/check-media.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:deploy && pnpm build",
    "media:fixture": "docker compose -f media/compose.yml --profile fixture up -d",
    "media:fixture:stop": "docker compose -f media/compose.yml stop fixture"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css}": "biome check --write --no-errors-on-unmatched"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-virtual": "^3.14.13",
    "clsx": "^2.1.1",
    "hls.js": "^1.7.3",
    "lucide-react": "^1.47.0",
    "msw": "^2.15.0",
    "next": "^16.3.6",
    "next-intl": "^4.14.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fake-indexeddb": "^6.2.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "type": "module",
  "packageManager": "pnpm@11.21.0"
}
